# /etc/llama-server/llama-server.env
# Wird von llama-server.service geladen. Rechte: chmod 600, Besitzer root.
# llama-server liest diese Variablen direkt (entsprechen den CLI-Flags).

# Im LAN erreichbar machen (Standard wäre nur 127.0.0.1).
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080

# Wer im LAN lauscht, sollte einen API-Key setzen (beliebiger langer Zufallswert,
# z. B. `openssl rand -hex 24`). Home Assistant & Co. schicken ihn als Bearer-Token.
LLAMA_API_KEY=bitte-aendern

# Router-Modus: Modelle aus der Preset-Datei, immer nur eins gleichzeitig im Speicher.
LLAMA_ARG_MODELS_PRESET=/etc/llama-server/models.ini
LLAMA_ARG_MODELS_MAX=1

# Cache für per Hugging Face geladene Modelle.
LLAMA_CACHE=/var/lib/llama-server/cache
